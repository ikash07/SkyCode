PORT=4000
# Use MongoDB Atlas (free): https://www.mongodb.com/cloud/atlas
# Or local MongoDB: mongodb://127.0.0.1:27017/online_ide
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/online_ide?retryWrites=true&w=majority
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
DOCKER_EXECUTION_TIMEOUT_SECONDS=12
DOCKER_EXECUTION_MEMORY_MB=512
DOCKER_EXECUTION_CPU_QUOTA=1.0
