# This is the ROOT .env — loaded by the dev script
# For backend-specific config, see backend/.env.example

PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/online_ide?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
DOCKER_EXECUTION_TIMEOUT_SECONDS=12
DOCKER_EXECUTION_MEMORY_MB=512
DOCKER_EXECUTION_CPU_QUOTA=1
